function loadLeaveFile(file){
  if(!STAFF.length){ alert('먼저 명단(ERP)을 업로드해주세요.'); return; }
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const wb=XLSX.read(e.target.result,{type:'binary',cellDates:true});
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,dateNF:'yyyy-mm-dd'});
      let hIdx=-1, cName=-1, cContent=-1;
      for(let i=0;i<Math.min(rows.length,8);i++){
        const row=(rows[i]||[]).map(x=>String(x||'').replace(/\s/g,''));
        const ni=row.findIndex(h=>/성명|이름|사원명/.test(h));
        const ci=row.findIndex(h=>/휴직내용|내용|기간|비고|휴직/.test(h));
        if(ni>=0 && ci>=0){ hIdx=i; cName=ni; cContent=ci; break; }
      }
      if(hIdx<0){ cName=4; cContent=7; }
      const leaveByName={};
      const startR = hIdx<0 ? 0 : hIdx+1;
      for(let i=startR;i<rows.length;i++){
        const r=rows[i]; if(!r) continue;
        const name=String(r[cName]||'').trim();
        const content=String(r[cContent]||'').trim();
        if(!name||!content) continue;
        if(!leaveByName[name]) leaveByName[name]=[];
        leaveByName[name].push(content);
      }
      let applied=0, notfound=[];
      Object.keys(leaveByName).forEach(name=>{
        const matches=STAFF.filter(s=>s.name===name);
        if(matches.length===0){ notfound.push(name); return; }
        const text=leaveByName[name].join('\n');
        matches.forEach(s=>{ s.leave = text; });
        applied++;
      });
      dropLeave.classList.add('loaded');
      let msg=`✓ ${file.name} — ${applied}명 휴직 자동입력`;
      if(notfound.length) msg+=` · 명단에 없음: ${notfound.slice(0,8).join(', ')}${notfound.length>8?' 외 '+(notfound.length-8)+'명':''}`;
      document.getElementById('filemetaLeave').textContent=msg;
      buildLeaveInputs();
      recalc();
    }catch(err){ alert('휴직파일 오류: '+err.message); }
  };
  reader.readAsBinaryString(file);
}

