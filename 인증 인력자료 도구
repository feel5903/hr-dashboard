<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>인증 인력자료 자동계산</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --ink:#1c2b2d; --ink2:#4a5c5e; --line:#dce4e3; --line2:#c3d0cf;
    --bg:#f4f7f6; --panel:#ffffff; --accent:#0f6e56; --accent-soft:#e1f5ee;
    --warn:#a35a2d; --warn-soft:#faece0; --danger:#a32d2d; --danger-soft:#fbeaea;
    --ok:#0f6e56; --ok-soft:#e1f5ee;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:"Pretendard","맑은 고딕","Malgun Gothic",-apple-system,sans-serif;
    background:var(--bg);color:var(--ink);font-size:14px;line-height:1.6}
  .wrap{max-width:1180px;margin:0 auto;padding:24px 20px 80px}
  header.top{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:4px}
  header.top h1{font-size:21px;font-weight:700;margin:0;letter-spacing:-.02em}
  header.top .sub{color:var(--ink2);font-size:13px}
  .steps{display:flex;gap:8px;margin:18px 0 22px;flex-wrap:wrap}
  .step{font-size:12px;color:var(--ink2);background:var(--panel);border:1px solid var(--line);
    border-radius:20px;padding:5px 13px}
  .step b{color:var(--accent);font-weight:700;margin-right:5px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;
    padding:20px 22px;margin-bottom:18px}
  .panel h2{font-size:15px;font-weight:700;margin:0 0 4px;display:flex;align-items:center;gap:8px}
  .panel h2 .n{background:var(--accent);color:#fff;width:22px;height:22px;border-radius:50%;
    display:inline-flex;align-items:center;justify-content:center;font-size:12px;flex:none}
  .panel .hint{color:var(--ink2);font-size:12.5px;margin:0 0 14px}
  .row{display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end}
  .field{display:flex;flex-direction:column;gap:5px}
  .field label{font-size:12px;color:var(--ink2);font-weight:600}
  input[type=date],input[type=text],select{border:1px solid var(--line2);border-radius:9px;
    padding:9px 11px;font-size:14px;font-family:inherit;background:#fff;color:var(--ink)}
  input[type=date]:focus,input[type=text]:focus,textarea:focus{outline:2px solid var(--accent-soft);border-color:var(--accent)}
  .btn{border:none;border-radius:10px;padding:10px 18px;font-size:13.5px;font-weight:700;
    cursor:pointer;font-family:inherit;transition:.12s}
  .btn.primary{background:var(--accent);color:#fff}
  .btn.primary:hover{background:#0c5a46}
  .btn.ghost{background:#fff;border:1px solid var(--line2);color:var(--ink)}
  .btn.ghost:hover{border-color:var(--accent);color:var(--accent)}
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .drop{border:2px dashed var(--line2);border-radius:12px;padding:26px;text-align:center;
    color:var(--ink2);cursor:pointer;transition:.12s;background:#fafcfb}
  .drop:hover,.drop.over{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
  .drop .big{font-size:15px;font-weight:700;color:var(--ink);margin-bottom:4px}
  .drop.loaded{border-style:solid;border-color:var(--accent);background:var(--accent-soft)}
  .filemeta{font-size:12.5px;color:var(--accent);font-weight:600;margin-top:8px}
  table{width:100%;border-collapse:collapse;font-size:12.5px}
  th,td{border-bottom:1px solid var(--line);padding:7px 9px;text-align:left;vertical-align:top}
  th{background:#eef4f2;font-weight:700;color:var(--ink);position:sticky;top:0;font-size:12px;white-space:nowrap}
  td.num{text-align:right;font-variant-numeric:tabular-nums}
  .tablewrap{max-height:440px;overflow:auto;border:1px solid var(--line);border-radius:10px}
  tr.flag td{background:var(--danger-soft)}
  tr.excluded td{color:#aab4b3;background:#fafbfb}
  .badge{display:inline-block;font-size:11px;padding:2px 7px;border-radius:6px;font-weight:700}
  .badge.reg{background:var(--accent-soft);color:var(--accent)}
  .badge.con{background:#fdeede;color:var(--warn)}
  .badge.flag{background:var(--danger-soft);color:var(--danger)}
  .badge.note-b{background:#eef0f0;color:#5f6d6c;font-weight:600}
  .badge.excl{background:#eef0f0;color:#8b9695}
  .summary{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:16px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 18px;min-width:130px}
  .card .k{font-size:12px;color:var(--ink2);font-weight:600}
  .card .v{font-size:24px;font-weight:800;letter-spacing:-.02em;margin-top:2px}
  .card.warn{border-color:#e9c9a8;background:var(--warn-soft)}
  .card.warn .v{color:var(--warn)}
  .leaveinput{width:100%;min-height:70px;border:1px solid var(--line2);border-radius:9px;
    padding:8px 10px;font-size:12.5px;font-family:inherit;resize:vertical;line-height:1.5}
  details.help{margin-top:10px;font-size:12.5px;color:var(--ink2)}
  details.help summary{cursor:pointer;font-weight:600;color:var(--accent)}
  details.help ul{margin:8px 0 0;padding-left:18px}
  details.help li{margin:3px 0}
  .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
  .toolbar .spacer{flex:1}
  .pill-filter{display:flex;gap:6px}
  .pill-filter button{border:1px solid var(--line2);background:#fff;border-radius:18px;
    padding:5px 13px;font-size:12px;cursor:pointer;font-weight:600;color:var(--ink2)}
  .pill-filter button.on{background:var(--accent);color:#fff;border-color:var(--accent)}
  .empty{color:var(--ink2);text-align:center;padding:40px;font-size:13px}
  .editcell input{width:70px;padding:4px 6px;font-size:12px;border:1px solid var(--line2);border-radius:6px}
  .note{font-size:12px;color:var(--warn);background:var(--warn-soft);border-radius:8px;
    padding:9px 12px;margin-top:10px;border:1px solid #e6d4bd}
  .mini{font-size:11.5px;color:var(--ink2)}
  .leavecell{max-width:280px;white-space:pre-wrap;font-size:11.5px;line-height:1.45}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <h1>인증 인력자료 자동계산</h1>
    <span class="sub">서울재활병원 · 조사기간 실제근무일수 · 휴직차감 · 평균인원 산출</span>
  </header>

  <div style="display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 4px;align-items:center">
    <button class="btn ghost" id="saveFileBtn" style="padding:8px 14px;font-size:12.5px">💾 작업 저장(파일)</button>
    <button class="btn ghost" id="loadFileBtn2" style="padding:8px 14px;font-size:12.5px">📂 저장파일 불러오기</button>
    <input type="file" id="restoreInput" accept=".json" style="display:none">
    <span class="mini" id="autoSaveStatus" style="color:var(--accent)"></span>
  </div>

  <div class="steps">
    <span class="step"><b>1</b>조사기간 설정</span>
    <span class="step"><b>2</b>명단 업로드</span>
    <span class="step"><b>3</b>휴직·전환 입력</span>
    <span class="step"><b>4</b>계산·검토</span>
    <span class="step"><b>5</b>엑셀 출력</span>
  </div>

  <!-- STEP 1 -->
  <section class="panel">
    <h2><span class="n">1</span>조사기간 설정</h2>
    <p class="hint">인증 조사기간을 지정하세요. 이 기간에 하루라도 재직한 사람만 자동으로 추립니다. (기간 전 퇴사자·기간 후 입사자는 제외)</p>
    <div class="row">
      <div class="field">
        <label>조사 시작일</label>
        <input type="date" id="periodStart" value="2025-09-01">
      </div>
      <div class="field">
        <label>조사 종료일</label>
        <input type="date" id="periodEnd" value="2026-08-31">
      </div>
      <div class="field">
        <label>기준일수(자동)</label>
        <input type="text" id="baseDays" readonly style="width:100px;background:#f0f4f3">
      </div>
    </div>
  </section>

  <!-- STEP 2 -->
  <section class="panel">
    <h2><span class="n">2</span>명단 업로드</h2>
    <p class="hint">ERP 인사카드 엑셀을 그대로 올리세요. 성명·주민번호·부서·직급·입사일·퇴사일 열을 자동으로 찾습니다. (예전 퇴사자까지 다 있어도 시스템이 조사기간 해당자만 걸러냅니다)</p>
    <div class="drop" id="drop">
      <div class="big">엑셀 파일을 여기에 놓거나 클릭해서 선택</div>
      <div class="mini">.xlsx / .xls · ERP 원본 그대로 가능</div>
      <div class="filemeta" id="filemeta"></div>
    </div>
    <input type="file" id="fileInput" accept=".xlsx,.xls" style="display:none">
  </section>

  <!-- STEP 2.5 휴가내역 (선택) -->
  <section class="panel">
    <h2><span class="n">+</span>휴가내역 업로드 <span style="font-size:12px;font-weight:400;color:var(--ink2)">(선택 · 개인휴가 이어붙임 자동확인)</span></h2>
    <p class="hint">근태조회 엑셀을 올리면, 휴직 입력한 사람 중 <b>휴직 앞뒤에 개인휴가를 연속으로 붙인 사람</b>을 자동으로 찾아 표시합니다. (종일 휴가만, 주말 끼면 끊긴 걸로)</p>
    <div class="drop" id="dropVac" style="padding:18px">
      <div class="big" style="font-size:14px">휴가내역(근태조회) 엑셀 놓기 / 클릭</div>
      <div class="filemeta" id="filemetaVac"></div>
    </div>
    <input type="file" id="fileInputVac" accept=".xlsx,.xls" style="display:none">
  </section>

  <!-- STEP 3 -->
  <section class="panel" id="leavePanel" style="display:none">
    <h2><span class="n">3</span>휴직·단축·전환 입력</h2>
    <p class="hint">휴직이 있는 사람만 입력하면 됩니다. <b>기간만 넣으면 일수는 자동계산</b>돼요. 지금 쓰시던 문장 그대로 붙여넣어도 시스템이 해석합니다.</p>

    <div style="background:#eef4f2;border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:14px">
      <div style="font-weight:700;font-size:13.5px;margin-bottom:4px">휴직명단 엑셀 업로드 <span style="font-weight:400;color:var(--ink2);font-size:12px">(한 번에 일괄 입력)</span></div>
      <p class="mini" style="margin:0 0 8px">정리한 휴직 엑셀을 올리면 성명·휴직내용을 자동으로 찾아 채웁니다. 같은 사람이 여러 줄이면 자동 합산돼요. (성명 열 + 휴직내용 열만 있으면 됩니다)</p>
      <div class="drop" id="dropLeave" style="padding:16px">
        <div class="big" style="font-size:13.5px">휴직명단 엑셀 놓기 / 클릭</div>
        <div class="filemeta" id="filemetaLeave"></div>
      </div>
      <input type="file" id="fileInputLeave" accept=".xlsx,.xls" style="display:none">
    </div>

    <div style="background:#f0f6f4;border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:14px">
      <div style="font-weight:700;font-size:13.5px;margin-bottom:4px">정규직 전환자 일괄 입력</div>
      <p class="mini" style="margin:0 0 8px">정직자 명단을 붙여넣으세요. <b>이름 [탭 또는 공백] 전환일</b> 형식이면 자동으로 매칭됩니다. (한 줄에 한 명)</p>
      <textarea id="bulkTrans" class="leaveinput" style="min-height:80px"></textarea>
      <div style="display:flex;gap:8px;align-items:center;margin-top:8px">
        <button class="btn primary" id="applyBulkTrans" style="padding:8px 16px">전환일 일괄 적용</button>
        <span class="mini" id="bulkTransResult"></span>
      </div>
    </div>
    <div id="leaveList"></div>
    <details class="help">
      <summary>입력 방법 & 자동해석 규칙 보기</summary>
      <ul>
        <li><b>전일 휴직</b>(안식·출산·육아·질병·산재·가족돌봄): "안식 25.11.12~25.12.11" → 기간일수 그대로 차감</li>
        <li><b>단축근무(주 단위)</b>: "육아기단축 25.02.24~25.05.23 주15시간" → (40−15)/40 비율로 자동차감</li>
        <li><b>단축근무(일 단위)</b>: "25.03.01~25.06.30 일 6시간" → (8−6)/8 비율로 자동차감</li>
        <li><b>주N일 근무</b>: "주4일" → 주32시간으로 환산 / "주3일" → 주24시간</li>
        <li><b>기간 없이 시간만</b>: "일 6시간 근무" → 조사기간 전체 기준으로 계산</li>
        <li><b>여러 휴직</b>: 줄을 바꿔서 여러 개 입력하면 자동 합산</li>
        <li><b>16일 미만</b>은 자동으로 만근(0) 처리 / <b>조사기간 벗어난 부분</b>은 자동으로 잘림</li>
        <li>앞뒤 개인휴가를 포함해야 하면 그만큼 종료일을 늘려서 입력하세요</li>
      </ul>
    </details>
  </section>

  <!-- STEP 4 -->
  <section class="panel" id="resultPanel" style="display:none">
    <h2><span class="n">4</span>계산 결과 · 검토</h2>
    <div class="summary" id="summary"></div>
    <div class="toolbar">
      <div class="pill-filter" id="filter">
        <button data-f="all" class="on">전체</button>
        <button data-f="leave">휴직입력</button>
        <button data-f="reg">정규직</button>
        <button data-f="con">계약직</button>
        <button data-f="flag">확인필요</button>
      </div>
      <div class="spacer"></div>
      <button class="btn ghost" id="recalcBtn">다시 계산</button>
      <button class="btn primary" id="exportBtn">엑셀 다운로드</button>
    </div>
    <div class="tablewrap">
      <table id="resultTable">
        <thead>
          <tr>
            <th>#</th><th>부서</th><th>분류</th><th>성명</th><th>고용</th>
            <th>입사일</th><th>퇴사일</th><th>전환일</th>
            <th class="num">재직일수</th><th class="num">휴직차감</th><th class="num">실제근무일</th>
            <th>휴직내역(해석)</th>
          </tr>
        </thead>
        <tbody id="resultBody"></tbody>
      </table>
    </div>
    <div class="note" id="flagNote" style="display:none"></div>
  </section>

  <!-- STEP 5: 평균인원 -->
  <section class="panel" id="avgPanel" style="display:none">
    <h2><span class="n">5</span>분류별 평균인원</h2>
    <p class="hint">분류별 실제근무일 합계 ÷ 기준일수 = 평균인원. 정규직·계약직을 나눠서 집계합니다.</p>
    <div class="tablewrap" style="max-height:none">
      <table id="avgTable">
        <thead>
          <tr><th>분류</th>
            <th class="num">전체 근무일합</th><th class="num">전체 평균인원</th>
            <th class="num">정규직 근무일합</th><th class="num">정규 평균인원</th>
            <th class="num">계약직 근무일합</th><th class="num">계약 평균인원</th>
          </tr>
        </thead>
        <tbody id="avgBody"></tbody>
      </table>
    </div>
  </section>

  <!-- STEP 6: 인증 제출 서식 (한글 별지 제23호의6) -->
  <section class="panel" id="formPanel" style="display:none">
    <h2><span class="n">6</span>인증 제출용 서식 (의료기관 운영현황 제3쪽)</h2>
    <p class="hint">한글 서식 순서·명칭 그대로입니다. 이대로 한글파일에 옮겨적으면 됩니다. (임시직·용역직·파견직 열은 제외)</p>
    <div class="tablewrap" style="max-height:none">
      <table id="formTable">
        <thead>
          <tr><th colspan="2">분류</th><th class="num">계</th><th class="num">정규직</th><th class="num">계약직</th></tr>
        </thead>
        <tbody id="formBody"></tbody>
      </table>
    </div>
    <div style="margin-top:12px">
      <button class="btn primary" id="exportFormBtn">인증 서식 엑셀 다운로드</button>
    </div>
  </section>
</div>

<script>
/* ================= 부서→분류 기본 매핑 ================= */
const DEPT_MAP = {"성인간호과":"간호사","QPS실":"간호사","성인병동간호팀":"간호사","소아청소년간호과":"간호사","외래간호팀":"간호사","소아청소년병동간호팀":"간호사","수도권공공어린이재활운영단":"간호사","고객경험실":"간호사","감염관리실":"간호사","지역장애인보건의료센터":"간호사","성인언어치료팀":"기타","소아청소년재활심리팀":"기타","소아청소년언어치료팀":"기타","성인재활심리팀":"기타","가족지원센터":"기타","시설팀":"기타","약제팀":"약사","총무행정팀":"기타","신경계물리치료팀":"물리치료사","미래기획실":"물리치료사","소아청소년치료과":"물리치료사","미래재활연구팀":"물리치료사","성인치료과":"물리치료사","청소년물리치료팀":"물리치료사","근골격계물리치료팀":"물리치료사","소아물리치료팀":"물리치료사","지역사회재활지원팀":"물리치료사","진료지원팀":"방사선사","원무행정팀":"보건의료정보관리사","성인사회복지팀":"사회복지사","당직과":"일반의","성인작업치료팀":"작업치료사","소아작업치료팀":"작업치료사","청소년작업치료팀":"작업치료사","병원장":"전문의","부원장":"전문의","소아청소년진료과":"전문의","회복기병원부":"전문의","성인진료과":"전문의","기능연구센터":"전문의","공공어린이재활병원부":"전문의","재무회계팀":"행정사무직","원무과":"행정사무직","진료협력팀":"행정사무직","인사과":"행정사무직","보험심사팀":"행정사무직","행정처":"행정사무직","후원협력팀":"행정사무직","총무과":"행정사무직","디지털재활혁신팀":"행정사무직","전산팀":"행정사무직","디지털혁신팀":"행정사무직","적정의료서비스센터":"행정사무직"};

/* 직책(직위) → 분류: 직종이 명확한 직책은 부서보다 우선 */
const TITLE_MAP = {"물리치료사":"물리치료사","작업치료사":"작업치료사","간호사":"간호사","수간호사":"간호사","간호조무사":"간호조무사","간호조무장":"간호조무사","사회복지사":"사회복지사","의료사회복지사":"사회복지사","영양사":"영양사","임상병리사":"임상병리사","방사선사":"방사선사","약사":"약사","한약사":"한약사","보건의료정보관리사":"보건의료정보관리사","원무행정직":"보건의료정보관리사","당직과장":"일반의","진료과장":"전문의","병원장":"전문의","부원장":"전문의"};

/* 부서+직책으로 분류 판정: 직책에 직종이 있으면 그것, 아니면 부서 */
function classify(dept, title){
  const t=(title||'').trim();
  if(TITLE_MAP[t]) return TITLE_MAP[t];
  return DEPT_MAP[dept] || '기타';
}

/* ================= 날짜 유틸 ================= */
function parseDate(s){
  if(s==null) return null;
  if(s instanceof Date) return new Date(s.getFullYear(),s.getMonth(),s.getDate());
  if(typeof s==='number'){ // 엑셀 시리얼
    const d=XLSX.SSF.parse_date_code(s); if(!d) return null;
    return new Date(d.y,d.m-1,d.d);
  }
  let t=String(s).trim().replace(/\.$/,'').replace(/[.\/\s]+/g,'-');
  const p=t.split('-').filter(x=>x!=='');
  if(p.length!==3) return null;
  let[y,m,d]=p.map(Number);
  if(y<100) y+=2000;
  if(!y||!m||!d) return null;
  const dt=new Date(y,m-1,d);
  return isNaN(dt)?null:dt;
}
function daysIncl(a,b){ return b>=a ? Math.round((b-a)/86400000)+1 : 0; }
function clip(s,e,ps,pe){ // 기간 교집합
  const lo=s>ps?s:ps, hi=e<pe?e:pe;
  return hi>=lo ? {s:lo,e:hi,days:daysIncl(lo,hi)} : {s:null,e:null,days:0};
}
function fmtDate(d){ if(!d) return ''; return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
function round3(n){ return Math.round(n*1000)/1000; }

/* ================= 휴직 문장 해석 ================= */
function parseLeaveLine(line, ps, pe){
  const raw=line.trim();
  if(!raw) return null;
  // 날짜쌍
  // 날짜쌍: 물결(~) 또는 하이픈(-)으로 연결된 두 날짜 모두 인식
  // 날짜는 점(.)이나 슬래시(/)로 구분된 YYYY.MM.DD 형식으로 잡고, 그 사이 연결자는 ~ 또는 -
  let dm=raw.match(/(\d{2,4}[.\/]\s*\d{1,2}[.\/]\s*\d{1,2}\.?)\s*[~∼\-]\s*(\d{2,4}[.\/]\s*\d{1,2}[.\/]\s*\d{1,2}\.?)/);
  if(!dm){
    // 날짜가 하이픈 구분(2025-11-12)인 경우: 물결로 연결된 것만
    dm=raw.match(/(\d{4}-\d{1,2}-\d{1,2})\s*[~∼]\s*(\d{4}-\d{1,2}-\d{1,2})/);
  }
  let start=null,end=null;
  if(dm){ start=parseDate(dm[1]); end=parseDate(dm[2]); }
  // 시간
  const wh=raw.match(/주\s*(\d+)\s*시간/);
  const wd=raw.match(/주\s*(\d+)\s*일/);
  const dh=raw.match(/(\d+)\s*시간/);
  const manual=raw.match(/->\s*([\d.]+)\s*$/);
  const hasWorkdayNote=/근무일/.test(raw); // "근무일:219일" 같은 수동환산 표기

  let type='full', reduceHours=null, base=null, dur=null, note='';
  let clipped=null, ambiguous=false;
  if(start&&end){ clipped=clip(start,end,ps,pe); dur=clipped.days; }

  // 복합/모호 케이스: 주N일과 시간이 동시 or 근무일 수동표기 → 자동계산 대신 확인필요
  if((wd&&dh) || hasWorkdayNote){ ambiguous=true; }

  // 우선순위: 주N시간 > 주N일 > (일)N시간 > 전일
  if(wh){ type='short'; reduceHours=+wh[1]; base='week'; }
  else if(wd){ type='short'; reduceHours=(+wd[1])*8; base='week'; note='주'+wd[1]+'일→주'+((+wd[1])*8)+'시간'; }
  else if(dh){ type='short'; reduceHours=+dh[1]; base='day'; }

  let deduct=0, ok=true, desc='';
  if(ambiguous){
    return {raw,start,end,type:'ambiguous',reduceHours,base,dur,deduct:0,ok:false,
            desc:'복합표현 - 직접 확인 필요',manual:manual?+manual[1]:null,note};
  }
  if(type==='short'){
    if(!dur){ // 기간 없음 → 조사기간 전체
      dur=daysIncl(ps,pe);
      note=(note?note+' · ':'')+'기간없음→전체'+dur+'일';
    }
    if(base==='week'){ deduct=dur*(40-reduceHours)/40; desc=`${dur}일 주${reduceHours}시간→${round3(deduct)}`; }
    else { deduct=dur*(8-reduceHours)/8; desc=`${dur}일 ${reduceHours}시간→${round3(deduct)}`; }
    if(reduceHours>= (base==='week'?40:8)){ ok=false; desc='근무시간 과다'; }
  } else { // 전일 휴직
    if(!start||!end){ ok=false; desc='날짜 인식 실패'; }
    else { deduct=dur; desc=`${dur}일`; }
  }
  return {raw,start,end,type,reduceHours,base,dur,deduct:round3(deduct),ok,desc,
          manual: manual?+manual[1]:null, note};
}

// 사람 1명 휴직 전체 텍스트 → 결과
function computeLeave(text, ps, pe, transDate){
  if(!text||!text.trim()) return {total:0,lines:[],flags:[],notes:[],regDed:0,conDed:0};
  const lines=[], flags=[], notes=[];
  let total=0;
  for(const ln of text.split(/\n+/)){
    if(!ln.trim()) continue;
    const p=parseLeaveLine(ln, ps, pe);
    if(!p) continue;
    lines.push(p);
    if(!p.ok){ flags.push('해석 확인: '+p.raw); continue; }
    total+=p.deduct;
    // 수기값과 큰 차이나면 플래그 (오타/특수 감지)
    if(p.manual!=null && Math.abs(p.manual-p.deduct)>0.5){
      flags.push(`계산 ${round3(p.deduct)} ≠ 원본 ${p.manual}`);
    }
  }
  return {total:round3(total),lines,flags,notes};
}

/* ================= 상태 ================= */
let STAFF=[];       // {dept,name,jumin,rank,hire,leave(입력),trans,emp,cls, ...계산}
let RESULT=[];
let VAC={};         // 이름 → Set(종일 휴가 날짜 ISO)
let curFilter='all';

/* ================= 파일 로드 ================= */
const drop=document.getElementById('drop'), fileInput=document.getElementById('fileInput');
drop.onclick=()=>fileInput.click();
drop.ondragover=e=>{e.preventDefault();drop.classList.add('over');};
drop.ondragleave=()=>drop.classList.remove('over');
drop.ondrop=e=>{e.preventDefault();drop.classList.remove('over');if(e.dataTransfer.files[0])loadFile(e.dataTransfer.files[0]);};
fileInput.onchange=e=>{if(e.target.files[0])loadFile(e.target.files[0]);};

/* 휴가내역 업로드 */
const dropVac=document.getElementById('dropVac'), fileInputVac=document.getElementById('fileInputVac');
dropVac.onclick=()=>fileInputVac.click();
dropVac.ondragover=e=>{e.preventDefault();dropVac.classList.add('over');};
dropVac.ondragleave=()=>dropVac.classList.remove('over');
dropVac.ondrop=e=>{e.preventDefault();dropVac.classList.remove('over');if(e.dataTransfer.files[0])loadVacFile(e.dataTransfer.files[0]);};
fileInputVac.onchange=e=>{if(e.target.files[0])loadVacFile(e.target.files[0]);};

function loadVacFile(file){
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const wb=XLSX.read(e.target.result,{type:'binary',cellDates:true});
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,dateNF:'yyyy-mm-dd'});
      // 헤더 찾기 (사원명 + 근태일자 포함)
      let hIdx=-1;
      for(let i=0;i<Math.min(rows.length,8);i++){
        const j=(rows[i]||[]).map(x=>String(x||'')).join('');
        if(j.includes('사원명')&&j.includes('근태')){hIdx=i;break;}
      }
      if(hIdx<0){ alert('휴가파일 헤더(사원명·근태일자)를 찾지 못했어요.'); return; }
      const H=rows[hIdx];
      const cName=findCol(H,['사원명','성명','이름']);
      const cDate=findCol(H,['근태일자','근태일','일자']);
      const cVal=findCol(H,['근태','일수']); // F열 근태값
      // 근태값 열: '근태'라는 이름이 두 개일 수 있음(근태종류/근태) → 값 열은 숫자 들어간 열 탐색
      let cAmt=-1;
      for(let i=hIdx+1;i<Math.min(rows.length,hIdx+20);i++){
        const r=rows[i]; if(!r)continue;
        for(let c=0;c<r.length;c++){
          const v=r[c]; if(v!=null && !isNaN(parseFloat(v)) && Math.abs(parseFloat(v))<=1.5 && String(v).indexOf('20')!==0){ if(cAmt<0)cAmt=c; }
        }
        if(cAmt>=0)break;
      }
      if(cAmt<0) cAmt=findCol(H,['근태']);
      VAC={};
      let cnt=0;
      for(let i=hIdx+1;i<rows.length;i++){
        const r=rows[i]; if(!r)continue;
        const name=r[cName]; const d=parseDate(r[cDate]);
        const amt=parseFloat(r[cAmt]);
        if(!name||!d||isNaN(amt))continue;
        if(amt>=1.0){ // 종일만
          const nm=String(name).trim();
          if(!VAC[nm]) VAC[nm]=new Set();
          VAC[nm].add(fmtDate(d));
          cnt++;
        }
      }
      dropVac.classList.add('loaded');
      document.getElementById('filemetaVac').textContent=`✓ ${file.name} — 종일 휴가 ${cnt}건 (${Object.keys(VAC).length}명)`;
      recalc();
    }catch(err){ alert('휴가파일 오류: '+err.message); }
  };
  reader.readAsBinaryString(file);
}

/* 휴직 앞뒤 연속 개인휴가 탐지 */
function attachedLeave(name, leaveStart, leaveEnd){
  const dates=VAC[name]; if(!dates) return {before:0,after:0};
  let before=0, after=0;
  // 끝난 다음날부터 정방향
  let d=new Date(leaveEnd); d.setDate(d.getDate()+1);
  while(dates.has(fmtDate(d))){ after++; d.setDate(d.getDate()+1); }
  // 시작 전날부터 역방향
  d=new Date(leaveStart); d.setDate(d.getDate()-1);
  while(dates.has(fmtDate(d))){ before++; d.setDate(d.getDate()-1); }
  return {before,after};
}

function findCol(headers, keys){
  for(let i=0;i<headers.length;i++){
    const h=String(headers[i]||'').replace(/\s/g,'');
    for(const k of keys){ if(h.includes(k)) return i; }
  }
  return -1;
}

function loadFile(file){
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const wb=XLSX.read(e.target.value?e.target.value:e.target.result,{type:'binary',cellDates:true});
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:false,dateNF:'yyyy-mm-dd'});
      // 헤더행 찾기 (성명/부서/입사 포함된 행)
      let hIdx=-1;
      for(let i=0;i<Math.min(rows.length,10);i++){
        const joined=(rows[i]||[]).map(x=>String(x||'')).join('');
        if(joined.includes('성명')&&(joined.includes('입사')||joined.includes('부서'))){hIdx=i;break;}
      }
      if(hIdx<0){ showLoadNote('헤더(성명·부서·입사일)를 찾지 못했어요. 파일 형식을 확인해주세요.',true); return; }
      const H=rows[hIdx];
      const cName=findCol(H,['성명','사원명','이름']);
      const cDept=findCol(H,['부서']);
      const cJumin=findCol(H,['주민','주민등록번호']);
      const cRank=findCol(H,['직급']);
      const cTitle=findCol(H,['직책','직위','직위/업무','업무']);
      const cHire=findCol(H,['입사일','입사일자']);
      const cQuit=findCol(H,['퇴사일','퇴사일자']);
      if(cName<0||cHire<0){ showLoadNote('성명 또는 입사일 열을 찾지 못했어요.',true); return; }

      const list=[];
      for(let i=hIdx+1;i<rows.length;i++){
        const r=rows[i]; if(!r) continue;
        const name=r[cName]; if(!name||!String(name).trim()) continue;
        const hire=parseDate(r[cHire]);
        if(!hire) continue; // 입사일 없으면 스킵(더미행)
        const rank=cRank>=0?String(r[cRank]||'').trim():'';
        const dept=cDept>=0?String(r[cDept]||'').trim():'';
        const title=cTitle>=0?String(r[cTitle]||'').trim():'';
        list.push({
          dept, name:String(name).trim(),
          jumin:cJumin>=0?String(r[cJumin]||'').trim():'',
          rank, title, hire, quit:cQuit>=0?parseDate(r[cQuit]):null,
          leave:'', trans:'',
          emp: rank==='계약직'?'계약직':'정규직',
          cls: classify(dept, title)
        });
      }
      STAFF=list;
      drop.classList.add('loaded');
      document.getElementById('filemeta').textContent=`✓ ${file.name} — 전체 ${list.length}명 로드 (조사기간 해당자만 자동 추출)`;
      buildLeaveInputs();
      recalc();
    }catch(err){ showLoadNote('파일을 읽는 중 오류: '+err.message,true); }
  };
  reader.readAsBinaryString(file);
}
function showLoadNote(msg,isErr){
  if(isErr){ alert(msg); }
}

/* ================= 조사기간 해당자만 추출 ================= */
function inPeriod(s, ps, pe){
  // 입사일 <= 종료일 AND (퇴사일 없음 OR 퇴사일 >= 시작일)
  if(s.hire>pe) return false;
  if(s.quit && s.quit<ps) return false;
  return true;
}

/* ================= 휴직 입력 UI ================= */
