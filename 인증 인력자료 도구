/* ================= 엑셀 출력 ================= */
document.getElementById('exportBtn').onclick=()=>{
  if(!RESULT.length) return;
  const ps=document.getElementById('periodStart').value;
  const pe=document.getElementById('periodEnd').value;
  const base=daysIncl(parseDate(ps),parseDate(pe));
  // 명단 시트
  const rows=RESULT.map((r,i)=>({
    '순번':i+1,'부서':r.dept,'분류':r.cls,'성명':r.name,'주민등록번호':r.jumin,
    '고용형태':r.emp,'입사일':fmtDate(r.hire),'퇴사일':fmtDate(r.quit),'전환일':r.trans||'',
    '재직일수':r.workDays,'휴직차감(A)':r.deduct,'실제근무일수':r.actual,
    '정규직근무일':r.regDays,'계약직근무일':r.conDays,
    '휴직해석':r.leaveDesc,'확인필요':r.flags.join(' / ')
  }));
  const ws1=XLSX.utils.json_to_sheet(rows);
  // 평균 시트
  const agg={};
  RESULT.forEach(r=>{ if(!agg[r.cls])agg[r.cls]={all:0,reg:0,con:0};
    agg[r.cls].all+=r.actual;agg[r.cls].reg+=r.regDays;agg[r.cls].con+=r.conDays; });
  const avgRows=Object.keys(agg).sort().map(cls=>({
    '분류':cls,'전체근무일합':round3(agg[cls].all),'전체평균인원':+(agg[cls].all/base).toFixed(2),
    '정규직근무일합':round3(agg[cls].reg),'정규평균인원':+(agg[cls].reg/base).toFixed(2),
    '계약직근무일합':round3(agg[cls].con),'계약평균인원':+(agg[cls].con/base).toFixed(2)
  }));
  const ws2=XLSX.utils.json_to_sheet(avgRows);
  const info=XLSX.utils.aoa_to_sheet([['조사기간',ps+' ~ '+pe],['기준일수',base],['대상인원',RESULT.length],['생성일시',new Date().toLocaleString('ko-KR')]]);
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,info,'기준정보');
  XLSX.utils.book_append_sheet(wb,ws1,'인력명단');
  XLSX.utils.book_append_sheet(wb,ws2,'분류별평균인원');
  XLSX.writeFile(wb,`인증인력자료_${ps}_${pe}.xlsx`);
};

/* 초기 기준일수 */
document.getElementById('baseDays').value=daysIncl(parseDate('2025-09-01'),parseDate('2026-08-31'))+'일';

/* ================= 저장 / 불러오기 ================= */
const SAVE_KEY='cert_hr_tool_save_v1';
let autoSaveOK=true;

function snapshot(){
  return {
    periodStart:document.getElementById('periodStart').value,
    periodEnd:document.getElementById('periodEnd').value,
    staff:STAFF.map(s=>({
      dept:s.dept,name:s.name,jumin:s.jumin,rank:s.rank,title:s.title||"",
      hire:s.hire?fmtDate(s.hire):null, quit:s.quit?fmtDate(s.quit):null,
      leave:s.leave, trans:s.trans, emp:s.emp, cls:s.cls
    })),
    savedAt:new Date().toISOString()
  };
}
function restore(data){
  if(!data) return;
  if(data.periodStart) document.getElementById('periodStart').value=data.periodStart;
  if(data.periodEnd) document.getElementById('periodEnd').value=data.periodEnd;
  if(Array.isArray(data.staff)){
    STAFF=data.staff.map(s=>({
      dept:s.dept,name:s.name,jumin:s.jumin,rank:s.rank,title:s.title||"",
      hire:s.hire?parseDate(s.hire):null, quit:s.quit?parseDate(s.quit):null,
      leave:s.leave||'', trans:s.trans||'', emp:s.emp||'정규직', cls:s.cls||'기타'
    }));
    if(STAFF.length){
      drop.classList.add('loaded');
      document.getElementById('filemeta').textContent=`✓ 저장된 명단 ${STAFF.length}명 복원됨`;
      buildLeaveInputs(); recalc();
    }
  }
}

// 자동저장 (localStorage, 실패해도 조용히)
function autoSave(){
  if(!autoSaveOK) return;
  try{
    localStorage.setItem(SAVE_KEY, JSON.stringify(snapshot()));
    const el=document.getElementById('autoSaveStatus');
    el.textContent='자동 저장됨 · '+new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'});
  }catch(e){ autoSaveOK=false;
    document.getElementById('autoSaveStatus').textContent='(자동저장 불가 - 파일 저장을 이용하세요)';
    document.getElementById('autoSaveStatus').style.color='var(--warn)';
  }
}
// 자동복원
(function tryAutoRestore(){
  try{
    const raw=localStorage.getItem(SAVE_KEY);
    if(raw){ restore(JSON.parse(raw)); }
  }catch(e){}
})();

// 파일 저장
document.getElementById('saveFileBtn').onclick=()=>{
  const blob=new Blob([JSON.stringify(snapshot(),null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  const ds=document.getElementById('periodStart').value, de=document.getElementById('periodEnd').value;
  a.href=url; a.download=`인증작업저장_${ds}_${de}.json`; a.click();
  URL.revokeObjectURL(url);
};
// 파일 불러오기
document.getElementById('loadFileBtn2').onclick=()=>document.getElementById('restoreInput').click();
document.getElementById('restoreInput').onchange=e=>{
  const f=e.target.files[0]; if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{ try{ restore(JSON.parse(ev.target.result)); autoSave(); }
    catch(err){ alert('저장파일을 읽을 수 없어요: '+err.message); } };
  r.readAsText(f);
};
</script>
