  if(!raw){ resEl.textContent='붙여넣은 내용이 없어요.'; resEl.style.color='var(--warn)'; return; }
  let applied=0, notfound=[];
  raw.split(/\n+/).forEach(line=>{
    const parts=line.trim().split(/[\t]+|\s{2,}|\s+/).filter(x=>x);
    if(parts.length<2) return;
    // 마지막 토큰이 날짜, 앞쪽이 이름
    const dateTok=parts[parts.length-1];
    const name=parts.slice(0,parts.length-1).join('');
    const d=parseDate(dateTok);
    if(!d){ return; }
    const iso=fmtDate(d);
    // 이름 매칭 (조사기간 대상자 우선)
    const matches=STAFF.filter(s=>s.name===name);
    if(matches.length===0){ notfound.push(name); return; }
    matches.forEach(s=>{ s.trans=iso; });
    applied++;
  });
  buildLeaveInputs(); recalc();
  let msg=`✓ ${applied}명 적용 완료`;
  if(notfound.length) msg+=` · 명단에 없는 이름: ${notfound.join(', ')}`;
  resEl.textContent=msg;
  resEl.style.color=notfound.length?'var(--warn)':'var(--accent)';
};
