  const ps=parseDate(document.getElementById('periodStart').value);
  const pe=parseDate(document.getElementById('periodEnd').value);
  const panel=document.getElementById('leavePanel');
  const box=document.getElementById('leaveList');
  const targets=STAFF.filter(s=>inPeriod(s,ps,pe));
  panel.style.display='block';
  box.innerHTML=`<p class="mini" style="margin:0 0 10px">조사기간 해당 <b>${targets.length}명</b> · 휴직 있는 사람만 입력하세요. 나머지는 비워두면 만근 처리됩니다.</p>`;
  // 검색 + 목록
  const search=document.createElement('input');
  search.type='text'; search.placeholder='이름으로 찾기…';
  search.style.cssText='margin-bottom:12px;width:220px';
  box.appendChild(search);
  const tbl=document.createElement('div');
  tbl.className='tablewrap'; tbl.style.maxHeight='360px';
  box.appendChild(tbl);
  function render(q){
    const rows=targets.filter(s=>!q||s.name.includes(q));
    tbl.innerHTML=`<table><thead><tr><th style="width:80px">성명</th><th style="width:110px">부서</th>
      <th style="width:60px">고용</th><th>휴직·단축 (기간만 넣으면 자동계산)</th>
      <th style="width:88px">정규직 전환일</th><th style="width:74px" class="num">실제근무일</th></tr></thead><tbody></tbody></table>`;
    const tb=tbl.querySelector('tbody');
    rows.forEach(s=>{
      const tr=document.createElement('tr');
      const idx=STAFF.indexOf(s);
      tr.innerHTML=`<td><b>${s.name}</b></td><td class="mini">${s.dept}</td>
        <td><span class="badge ${s.emp==='계약직'?'con':'reg'}">${s.emp}</span></td>
