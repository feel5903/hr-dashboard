/* ================= 계산 ================= */
function recalc(){
  const ps=parseDate(document.getElementById('periodStart').value);
  const pe=parseDate(document.getElementById('periodEnd').value);
  const base=daysIncl(ps,pe);
  document.getElementById('baseDays').value=base+'일';
  if(!STAFF.length) return;

  RESULT=[];
  STAFF.forEach(s=>{
    if(!inPeriod(s,ps,pe)){ return; }
    // 재직일수 (조사기간 ∩ [입사, 퇴사or종료])
    const endWork=s.quit||pe;
    const c=clip(s.hire, endWork, ps, pe);
    const workDays=c.days;
    // 휴직차감
    const trans=s.trans?parseDate(s.trans):null;
    const L=computeLeave(s.leave, ps, pe, trans);
    let deduct=L.total;

    // 개인휴가 이어붙임 탐지 (휴가파일 있을 때, 전일휴직 라인 대상)
    let attachedDays=0; const attachNotes=[];
    if(Object.keys(VAC).length && L.lines.length){
      L.lines.forEach(ln=>{
        if(ln.type==='full' && ln.ok && ln.start && ln.end){
          const at=attachedLeave(s.name, ln.start, ln.end);
          if(at.before+at.after>0){
            attachedDays+=at.before+at.after;
            attachNotes.push(`${at.before?'앞'+at.before+'일 ':''}${at.after?'뒤'+at.after+'일':''}`.trim());
          }
        }
      });
    }
    // 개인휴가는 조사기간 내로만 (근사: 그대로 더함), 차감에 합산
    if(attachedDays>0){
      deduct+=attachedDays;
      L.notes.push(`개인휴가 이어붙임 +${attachedDays}일 (${attachNotes.join(', ')})`);
    }

    // 16일 미만 만근 규칙: 전일휴직 + 붙은 개인휴가 합이 16 미만이면 제외
    const fullSum=L.lines.filter(x=>x.type==='full'&&x.ok).reduce((a,b)=>a+b.deduct,0)+attachedDays;
    if(fullSum>0 && fullSum<16){
      deduct-=fullSum; // 만근 처리
      L.notes.push(`휴직 ${round3(fullSum)}일 < 16일 → 만근 처리`);
    }
    deduct=round3(deduct);
    const actual=round3(Math.max(0, workDays-deduct));

    // 고용형태 분할 (전환일 기준)
    let regDays=0, conDays=0;
    if(s.emp==='계약직' && !trans){ conDays=actual; }
    else if(s.emp==='정규직' && !trans){ regDays=actual; }
    else if(trans){
      // 전환 전=계약, 전환 후=정규 (재직일 기준 비례배분; 휴직은 단순비례)
      const preC=clip(s.hire, new Date(trans-86400000), ps, pe).days;
      const postC=clip(trans, endWork, ps, pe).days;
      const tw=preC+postC || 1;
      // 휴직차감을 두 구간 재직일 비율로 배분 (걸침 케이스 근사)
      conDays=round3(Math.max(0, preC - deduct*preC/tw));
      regDays=round3(Math.max(0, postC - deduct*postC/tw));
    } else { regDays=actual; }

    RESULT.push({...s, ps,pe, workDays, deduct, actual, regDays, conDays,
      flags:L.flags, notes:L.notes||[], lines:L.lines,
      hasLeave: !!(s.leave&&s.leave.trim()),
      leaveDesc:L.lines.map(x=>x.desc).join(' · ')});
  });
  renderResult();
  renderAvg();
  if(typeof updateInlineActual==='function') updateInlineActual();
  if(typeof autoSave==='function') autoSave();
}

